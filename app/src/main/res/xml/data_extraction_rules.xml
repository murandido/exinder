<?xml version="1.0" encoding="utf-8"?>
<!--
    Keeps all app data out of cloud backups and phone-to-phone transfers.

    Decisions are keyed by MediaStore IDs, which are only meaningful on the
    phone that created them. Restored on another phone, they would point at
    different files: an unrelated file could be skipped as "kept" or even sent
    to the trash. allowBackup="false" alone doesn't cover device transfer on
    Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
