<?xml version="1.0" encoding="utf-8"?>
<!--
    Ícone: dois cards empilhados, como a pilha do swipe, com um coração
    verde-brat no card da frente. Desenhado na grade de 108dp dos ícones
    adaptativos; o conteúdo fica dentro do círculo seguro de 66dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card de trás: só o contorno, inclinado para a direita. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="12">
        <path
            android:pathData="M42,32 h24 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z"
            android:strokeWidth="3"
            android:strokeColor="#FF000000" />
    </group>

    <!-- Card da frente: preenchido, inclinado para a esquerda. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-8">
        <path
            android:fillColor="#FF000000"
            android:pathData="M42,32 h24 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z" />
        <path
            android:fillColor="#FF8ACE00"
            android:pathData="M54,63 L46.5,55.6 A4.6,4.6 0 0 1 54,49.4 A4.6,4.6 0 0 1 61.5,55.6 Z" />
    </group>
</vector>
