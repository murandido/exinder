<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon: two stacked cards, like the swipe stack, with a brat-green heart
    on the front card. Drawn on the 108dp adaptive icon grid; the content
    stays inside the 66dp safe zone circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back card: outline only, tilted to the right. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="12">
        <path
            android:pathData="M42,32 h24 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z"
            android:strokeWidth="3"
            android:strokeColor="#FF000000" />
    </group>

    <!-- Front card: filled, tilted to the left. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-8">
        <path
            android:fillColor="#FF000000"
            android:pathData="M42,32 h24 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z" />
        <path
            android:fillColor="#FF8ACE00"
            android:pathData="M54,63 L46.5,55.6 A4.6,4.6 0 0 1 54,49.4 A4.6,4.6 0 0 1 61.5,55.6 Z" />
    </group>
</vector>
